# Local paths may be absolute or relative to the command's working directory.
SYSTEMATIC_FX_DATA_ROOT=./data
SYSTEMATIC_FX_ARTIFACTS_ROOT=./artifacts

# Replace every placeholder before use. Never commit the real value.
SYSTEMATIC_FX_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/systematic_fx
SYSTEMATIC_FX_ADMIN_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/postgres

# Integration tests never infer a target from DATABASE_URL and accept only the
# fixed, isolated systematic_fx_test database.
SYSTEMATIC_FX_TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/systematic_fx_test
SYSTEMATIC_FX_SMOKE_PARQUET=./data/mbp-10/2022/01/03/glbx-mdp3-20220103.mbp-10.parquet

# PostgreSQL.app installation path on this workstation; override on other hosts.
SYSTEMATIC_FX_PSQL=/Library/PostgreSQL/18/bin/psql
SYSTEMATIC_FX_PG_BIN=/Library/PostgreSQL/18/bin
SYSTEMATIC_FX_LOCAL_PG_ROOT=./.local/postgres
